    "test:ai-rate-limit": "tsx scripts/test-ai-rate-limit.ts",
    "test:worn-outfit-feed": "tsx scripts/test-worn-outfit-feed.ts",
    "test:account-capabilities": "tsx scripts/test-account-capabilities.ts",
    "test:password-auth": "tsx scripts/test-password-auth.ts",
    "test:email-lookup": "tsx scripts/test-email-lookup.ts",
    "test:otp-request-budgets": "tsx scripts/test-otp-request-budgets.ts",
    "test:outfit-ai-prompt": "tsx scripts/test-outfit-ai-prompt.ts",
